ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model / effort (defaults: claude-opus-5-5, medium)
CLAUDE_MODEL=
CLAUDE_EFFORT=

# Optional: set a password for HTTP Basic Auth (leave blank to disable)
APP_PASSWORD=

# Optional: Google Sheets logging via Apps Script webhook (same as ROAST)
SHEETS_WEBHOOK_URL=

# Optional: override the port (default 3000)
PORT=3000
